{
  "rewrites":[
    {
      "source": "/api/backend/(.*)",
      "destination": "https://mrcriper-mentiumbackend.hf.space/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers":[
    {
      "source": "/api/backend/(.*)",
      "headers":[
        {
          "key": "Cache-Control",
          "value": "s-maxage=0, no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
